# For local web development. Signed commands run from the operator terminal.
VITE_AUTH_ENABLED=false

# Populate in the operator process environment or its secret store.
# BINGX_X01_API_KEY=
# BINGX_X01_API_SECRET=
# BINGX_X02_API_KEY=
# BINGX_X02_API_SECRET=
# CTS_H_REDIS=1
# CTS_H_STATE_DIR=/var/lib/cts-h
# CTS_H_ENABLE_ORDERS=bingx-x02
# CTS_H_MAX_NOTIONAL=150
# CTS_H_RISK_FRACTION=0.005
# CTS_H_ENTRY_BPS=10
# CTS_H_EXIT_BPS=20
